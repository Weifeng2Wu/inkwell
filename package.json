{
  "name": "inkwell",
  "version": "0.1.6",
  "private": true,
  "description": "AI-native LaTeX editor - Tauri desktop application",
  "author": "Inkwell",
  "license": "MIT",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "agent:setup": "node scripts/setup-agent-runtime.mjs",
    "agent:test": "node --test packages/academic-agent/test/*.test.mjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "clean": "turbo clean && rm -rf node_modules apps/desktop/node_modules",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "test:ci": "turbo test -- --reporter=verbose",
    "typecheck": "turbo typecheck",
    "version:sync": "node scripts/sync-version.mjs",
    "version:set": "node scripts/sync-version.mjs --version",
    "tauri:dev": "pnpm --filter @inkwell/desktop tauri:dev",
    "tauri:build": "pnpm --filter @inkwell/desktop tauri:build",
    "tauri:pkg": "pnpm tauri:build && ./scripts/build-pkg.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
